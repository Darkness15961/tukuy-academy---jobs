# Copia este archivo a .env para desarrollo local
# cp .env.example .env

# URL base del backend (sin barra final)
VITE_API_URL=http://localhost:8000/api/v1

# URL pública del frontend
VITE_APP_URL=http://localhost:5178

# Proveedor de autenticación: "api" conserva el backend HTTP anterior;
# "supabase" usa Supabase Auth en el proyecto principal.
VITE_AUTH_PROVIDER=supabase

# Valores públicos del proyecto Supabase principal. La anon key puede estar en
# el navegador siempre que todas las tablas expuestas tengan RLS y policies.
VITE_SUPABASE_PRIMARY_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_PRIMARY_ANON_KEY=TU_ANON_KEY

# Tras migraciones nuevas en principal, regenera tipos TS:
#   bun run gen:supabase-types
# (requiere `supabase login` una vez)

# Nunca agregues SUPABASE_SERVICE_ROLE_KEY a una variable VITE_*.

# true  = permite persistencia local (vacía) en módulos aún sin API/BD.
#         Con VITE_AUTH_PROVIDER=supabase NO se inyectan demos CIP/Andina:
#         la app arranca limpia (sinDatosDemo) y solo muestra datos reales o vacíos.
# false = consume APIs REST para todos los módulos (rompe lo que aún no tiene backend)
VITE_USE_MOCK=true

# true = academia real vía secondary-gateway (cursos, progreso, sesiones,
#        certificados, estudiantes, entregas/calificaciones, mensajes,
#        ingresos, bootstrap).
# Puede convivir con VITE_USE_MOCK=true: auth/bolsa/comunidad siguen en mock.
# Requiere migraciones en secundaria hasta 20260811160000 (certificado PDF + revocar;
# incluye 10200000 alumnos resumen, 195 firma, 194 asistencia…);
# + 20260811130000 calendar_event_id, 20260811140000 workflow labels,
# + 20260811141000 precio comercial checkout;
# y en principal 20260805244000 + 20260805248000
# (+ 20260805250000 editar accesos, + 20260805253000 permisos docente,
#  + 20260805259000 auto-alumno Tukuy Academy,
#  + 20260805260000 portal org miembros/licencia,
#  + 20260810180000 / 20260810181000 org_listar_miembros sin permisos ni alumnos STUDENT,
#  + 20260810190000 / 20260810191000 matrícula org + revisión catálogo,
#  + 20260811150000 organigrama institucional,
#  + 20260811151000 perfiles entidad,
#  + 20260811152000 presencia/identidad pública,
#  + 20260811153000 perfil org → permisos efectivos,
#  + 20260811154000 sedes + reglas de acceso curso,
#  + 20260811155000 asignaciones formación + rutas aprendizaje,
#  + 20260819160000 org_activar_incorporacion,
#  + 20260819170000 org_comunidad_cursos_solicitud);
# + secundaria 20260811161000 checkout idempotencia/acceso pago;
# + secundaria 20260819120000 duracion video YouTube,
#   20260819140000 duracion total curso,
#   20260820120000 fix duracion_minutos (evita "1 min" fantasma),
#   20260820140000 normalizar certificado curso (firmas 1–5 + plantillaId);
# Edge secret secondary-gateway: YOUTUBE_API_KEY (Data API v3) para duración real;
# redeploy de secondary-gateway, media-presign e izipay-webhook.
VITE_SECUNDARIA_CURSOS=false

# Pagos Izipay (estudiante / carrito).
# false = todos los cursos se inscriben gratis (sin carrito ni checkout).
# true  = activa carrito + pasarela cuando tengas la API configurada.
VITE_PASARELA_CURSOS=false
# simulacion = pasarela demo (default).
# dankira  = @dankira/izipay embebido (recomendado) + Edge izipay-lyra-proxy.
# sdk      = Token/Generate pop-up legado (izipay-session).
VITE_PAGO_MODO=simulacion
# Público (solo dankira / micuentaweb). NUNCA pongas el password en VITE_*.
# VITE_IZIPAY_MERCHANT_CODE=2352XXXX
# VITE_IZIPAY_PUBLIC_KEY=2352XXXX:testpublickey_XXXX...
# VITE_IZIPAY_SHA256=gwSUo27B8smXXX...
# VITE_IZIPAY_PRODUCTION=false
# VITE_IZIPAY_ENDPOINT=https://api.micuentaweb.pe
# Edge secrets PRINCIPAL (password del comercio — NO VITE_*):
#   IZIPAY_LYRA_MERCHANT_CODE=2352XXXX
#   IZIPAY_LYRA_PASSWORD=testpassword_XXXX...
#   IZIPAY_LYRA_ENV=sandbox
#   IZIPAY_LYRA_ENDPOINT=https://api.micuentaweb.pe
# Legado Token/Generate (modo sdk):
#   PAYMENT_MODE=simulacion|sandbox|live
#   IZIPAY_ENV=sandbox|production
#   IZIPAY_MERCHANT_CODE=...
#   IZIPAY_PUBLIC_KEY=...
#   IZIPAY_RSA_PUBLIC_KEY=...
#   IZIPAY_WEBHOOK_SECRET=...
# Redeploy: izipay-lyra-proxy (dankira), izipay-session, izipay-webhook, secondary-gateway
# Edge secret (secondary-gateway): PASARELA_CURSOS_HABILITADA=true cuando actives pagos.
# Flujo dankira: crear orden → setup() → formToken (proxy) → #izipay-form → confirmar.

# URL pública del bucket S3 (solo lectura de portadas/materiales).
# Opcional; si falta se usa el bucket por defecto tukuy-academy-media.
# VITE_MEDIA_PUBLIC_BASE_URL=https://tukuy-academy-media.s3.us-east-2.amazonaws.com

# Media AWS S3 — SOLO secrets de Edge Functions (supabase secrets set).
# NUNCA uses prefijo VITE_* (no deben llegar al navegador).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
# AWS_S3_BUCKET=tukuy-academy-media
# AWS_S3_PUBLIC_BASE_URL=https://tukuy-academy-media.s3.us-east-2.amazonaws.com

# Google Calendar + Meet — SOLO secrets de Edge Functions (proyecto PRINCIPAL).
# Flujo: OAuth de una cuenta organizadora (Tukuy) con refresh token.
# 1) Google Cloud Console → crear proyecto → habilitar "Google Calendar API"
# 2) Credenciales → OAuth client ID (Desktop o Web)
# 3) OAuth Playground (o app) → scope calendar.events → autorizar → refresh token
# 4) supabase secrets set GOOGLE_CALENDAR_CLIENT_ID=... GOOGLE_CALENDAR_CLIENT_SECRET=... GOOGLE_CALENDAR_REFRESH_TOKEN=...
# Opcional: GOOGLE_CALENDAR_ID=primary  GOOGLE_CALENDAR_TIMEZONE=America/Lima
# 5) Redeploy secondary-gateway
# 6) SQL secundaria: 20260811130000_sesion_calendar_event_id.sql
# Sin estos secretos, Meet sigue siendo simulado.
