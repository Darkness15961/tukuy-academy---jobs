# Rellena los valores DESPUÉS del signo = (sin espacios antes del valor).
# Guarda este archivo como: scripts/google-org.secrets.local
# Luego: bash scripts/aplicar-google-secrets-supabase.sh
#
# Usa comillas si el valor tiene caracteres especiales (#, /, etc.).

YOUTUBE_API_KEY="AIzaSy..."

GOOGLE_CALENDAR_CLIENT_ID="123456789-xxxx.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET="GOCSPX-..."
GOOGLE_CALENDAR_REFRESH_TOKEN="1//0g..."

# Login con Google (Supabase Auth) — script: configurar-google-auth-supabase.sh
GOOGLE_AUTH_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_AUTH_CLIENT_SECRET="GOCSPX-..."
